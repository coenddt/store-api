{
  "name": "users-file",
  "resource": "user",
  "opts": { "fileResolver": true },
  "steps": [
    { "method": "POST", "path": "/api/user", "body": { "name": "alice", "file": "hello" }, "expect": { "status": 201 } },
    { "method": "GET", "path": "/api/user/{id}/file", "useCreatedId": true, "expect": { "status": 200 } },
    { "method": "GET", "path": "/api/user/nope/file", "expect": { "status": 404, "errorCode": "NOT_FOUND" } }
  ]
}
